// ==========================================
// Tags Layout (Premium Golden Skill Tree - 金枝玉叶)
// ==========================================

// Glowing Pulse Animation
@keyframes pulseGold {
  0% { box-shadow: 0 0 0 0 rgba(234, 179, 8, 0.7); }
  70% { box-shadow: 0 0 0 10px rgba(234, 179, 8, 0); }
  100% { box-shadow: 0 0 0 0 rgba(234, 179, 8, 0); }
}

@keyframes floatTag {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-5px); }
}

article#tags
  position: relative
  display: flex
  flex-direction: column
  align-items: center
  padding: 60px 0
  margin-top: 20px
  background: transparent

  // 1. The Glowing Central Axis (流金中轴线)
  &::before
    content: ''
    position: absolute
    top: 0
    bottom: 0
    left: 50%
    width: 2px 
    background: linear-gradient(to bottom, transparent, #eab308 10%, #eab308 90%, transparent)
    transform: translateX(-50%)
    z-index: 0
    box-shadow: 0 0 15px #eab308, 0 0 5px #eab308 // Intense glow

  a.tag
    display: flex
    width: 50%
    position: relative
    text-decoration: none
    background: transparent !important
    border: none !important
    box-shadow: none !important
    z-index: 1
    animation: floatTag 6s ease-in-out infinite // Float effect
    
    // Kill the default '#' added by the theme
    &:before
      content: none !important
      display: none !important

    // Delay the floating animation randomly for each tag (pseudo-random using nth-child)
    &:nth-child(2n)
      animation-delay: -1s
    &:nth-child(3n)
      animation-delay: -2s
    &:nth-child(5n)
      animation-delay: -3s

    // ----------------------------------------
    // Odd Tags (Left side tags)
    // ----------------------------------------
    &:nth-child(odd)
      align-self: flex-start
      justify-content: flex-end
      padding-right: 60px
      margin: 20px 0
      
      // The Golden Branch (金枝)
      &::after
        content: ''
        position: absolute
        top: 50%
        right: 0
        width: 60px
        height: 40px
        border-bottom: 2px solid #eab308
        border-left: 2px solid #eab308
        border-bottom-left-radius: 12px // Crisp, techy curve
        transform: translateY(-50%)
        box-shadow: -2px 2px 5px rgba(234, 179, 8, 0.4) // Glow on the branch
        transition: all 0.3s ease
        z-index: 0
        
      // Glowing Node (能量节点)
      span.name::before
        content: ''
        position: absolute
        right: -36px // Aligns exactly on the corner of the branch
        top: 50%
        transform: translateY(-50%)
        width: 8px
        height: 8px
        border-radius: 50%
        background: #fff
        border: 2px solid #eab308
        box-shadow: 0 0 10px #eab308
        z-index: 3
        animation: pulseGold 2s infinite

    // ----------------------------------------
    // Even Tags (Right side tags)
    // ----------------------------------------
    &:nth-child(even)
      align-self: flex-end
      justify-content: flex-start
      padding-left: 60px
      margin: -20px 0 20px 0
      
      // The Golden Branch (金枝)
      &::after
        content: ''
        position: absolute
        top: 50%
        left: 0
        width: 60px
        height: 40px
        border-bottom: 2px solid #eab308
        border-right: 2px solid #eab308
        border-bottom-right-radius: 12px // Crisp, techy curve
        transform: translateY(-50%)
        box-shadow: 2px 2px 5px rgba(234, 179, 8, 0.4) // Glow on the branch
        transition: all 0.3s ease
        z-index: 0
        
      // Glowing Node (能量节点)
      span.name::before
        content: ''
        position: absolute
        left: -36px
        top: 50%
        transform: translateY(-50%)
        width: 8px
        height: 8px
        border-radius: 50%
        background: #fff
        border: 2px solid #eab308
        box-shadow: 0 0 10px #eab308
        z-index: 3
        animation: pulseGold 2s infinite
        animation-delay: -1s

    // ----------------------------------------
    // Glassmorphism Jade Tag (琉璃玉牌)
    // ----------------------------------------
    span.name
      background: rgba(255, 255, 255, 0.6)
      backdrop-filter: blur(10px) // Glass effect!
      -webkit-backdrop-filter: blur(10px)
      color: #333 !important
      border: 1px solid rgba(234, 179, 8, 0.5) // Golden rim
      border-radius: 8px
      padding: 10px 24px
      position: relative
      z-index: 2
      font-weight: 600
      font-size: 1rem
      letter-spacing: 1px
      box-shadow: 0 8px 32px 0 rgba(234, 179, 8, 0.15), inset 0 0 10px rgba(255, 255, 255, 0.5)
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275)

    // ----------------------------------------
    // Hover Interaction (激活态)
    // ----------------------------------------
    &:hover span.name
      background: rgba(234, 179, 8, 0.15) // Golden tint
      border-color: rgba(234, 179, 8, 0.9)
      color: #b45309 !important // Deep gold text
      transform: scale(1.08)
      box-shadow: 0 8px 32px 0 rgba(234, 179, 8, 0.3), inset 0 0 20px rgba(255, 255, 255, 0.8)
      text-shadow: 0 0 8px rgba(234, 179, 8, 0.4)

    &:hover::after
      border-color: #f59e0b
      box-shadow: 0 0 10px #f59e0b // Branch glows more!
